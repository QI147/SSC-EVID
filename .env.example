# Copy to .env (never commit it) or export these variables.
# Any OpenAI-compatible /chat/completions endpoint works.

EVID_API_KEY=sk-your-key
EVID_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EVID_MODEL=qwen3.8-flash

# Optional: refuse to send to any host other than this one.
# EVID_ALLOWED_HOST=dashscope.aliyuncs.com

# Optional: dataset/run root when datasets and runs live outside the repository.
# EVID_ROOT=D:/ssc-evid-work

# Optional: read the key from a key=value file instead of the environment.
# EVID_CRED_FILE=C:/keys/bailian.env

# Optional: cost estimate prices (CNY per 1M tokens), frozen for the paper at 0.8 / 2.7.
# EVID_PRICE_INPUT=0.8
# EVID_PRICE_OUTPUT=2.7
